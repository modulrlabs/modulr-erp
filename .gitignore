# ==============================================================================
# Multi-tenant Modular ERP + POS SaaS (.gitignore)
# Stack: Django + DRF + PostgreSQL (Backend) | React Vite + TS + Tailwind (Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Sensitive Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 3. Editor & IDE Specific Files
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml

# Sublime Text / Vim
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 4. Python & Django Backend
# ------------------------------------------------------------------------------
# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Django Local Static & Media Files
# User-uploaded files (e.g. receipts, shop logos, product images)
backend/media/
media/
# Collected static files for production deployment
backend/staticfiles/
staticfiles/

# Local SQLite databases (PostgreSQL is used, but SQLite might be generated locally)
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Python Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Code Quality & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.tox/

# Celery & Background Workers (if used for async tasks like WhatsApp / PDF receipts)
celerybeat-schedule
celerybeat.pid

# Django Debug & Logs
*.log
backend/logs/
logs/

# ------------------------------------------------------------------------------
# 5. Node.js & React (Vite + TypeScript) Frontend
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production & Build outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/

# Vite Caches
.vite/
frontend/.vite/

# TypeScript Cache
*.tsbuildinfo
.tsbuildinfo

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Testing & Coverage
coverage/
frontend/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 6. Miscellaneous & Temporary Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
.directory
