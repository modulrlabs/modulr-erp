# ==============================================================================
# Modulr ERP - Backend Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with real local values.
# NEVER commit real credentials or secret keys to source control!
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
USE_POSTGRES=True
DB_NAME=businezz_erp
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings (React Frontend at localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Cookie Hardening
AUTH_REFRESH_IN_BODY=False
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
